# ACIA — Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to git — add it to .gitignore

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: SQLite (default, zero config)
# DB_ENGINE=sqlite

# Option B: PostgreSQL
# DB_ENGINE=postgresql
# DATABASE_URL=postgresql://user:password@localhost:5432/acia
# OR set individually:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=acia
# DB_USER=acia_user
# DB_PASSWORD=your_password

# ── Authentication ────────────────────────────────────────────────────────────
# Your admin API key (generated on first startup by bootstrap_admin_key())
# Use this to issue keys to customers via POST /auth/keys
ACIA_ADMIN_KEY=

# ── SendGrid (email sending) ──────────────────────────────────────────────────
# Get a free key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=you@yourdomain.com
SENDGRID_FROM_NAME=Your Company Name

# ── Anthropic (LLM planning) ──────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
