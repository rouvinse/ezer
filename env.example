# EZER / ACIA — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must NEVER be committed.
#
# Railway injects DATABASE_URL and PORT automatically.
# All other vars must be set in the Railway service dashboard under "Variables".

# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL plugin sets this automatically.
# For local development with SQLite, leave both unset.
DATABASE_URL=postgresql://user:password@host:5432/railway
DB_ENGINE=postgresql

# ── Authentication ────────────────────────────────────────────────────────────
# The permanent admin API key. Set once, never change.
# Generate a strong random value: python -c "import secrets; print('acia_admin_sk_' + secrets.token_hex(32))"
# If unset, a random key is generated each boot — it won't persist across deploys.
ACIA_ADMIN_KEY=acia_admin_sk_your_64_char_hex_here

# ── Optional: Claude API for LLM-enhanced agent cycles ───────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Email actions via SendGrid ─────────────────────────────────────
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=noreply@yourapp.com

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically. Override only in local dev.
PORT=8000
LOG_LEVEL=INFO

# ── Railway-injected (do not set manually) ───────────────────────────────────
# RAILWAY_ENVIRONMENT=production
# RAILWAY_SERVICE_NAME=acia
